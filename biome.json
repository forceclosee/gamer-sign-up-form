{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/*.svg",
			"!**/routeTree.gen.ts",
			"!src/db/migrations",
			"!pnpm-lock.yaml",
			"!pnpn-workspace.yaml",
			"!**/*.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"includes": ["**", "!**/$.ts"],
		"rules": {
			"style": {
				"noDescendingSpecificity": "off"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "on",
					"fix": "safe"
				},
				"useTailwindStaticClassStrings": "on"
			},
			"correctness": {
				"noSolidDestructuredProps": "warn"
			},
			"performance": {
				"useSolidForComponent": "warn"
			},
			"suspicious": {
				"noDuplicatedSpreadProps": "on",
				"noReactSpecificProps": "error"
			}
		},
		"domains": {
			"tailwind": "all",
			"solid": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"bracketSameLine": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"bracketSameLine": true
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"tailwind": {
		"stylesheet": "./src/styles/global.css",
		"attributes": ["class", "className"],
		"mergeFunctions": ["clasList", "cn"]
	}
}
